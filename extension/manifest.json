{
  "manifest_version": 3,
  "name": "LiquiSight",
  "version": "1.0",
  "description": "AI Copilot for Visual Financial Intelligence",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Open LiquiSight"
  },
  "commands": {
    "toggle-liquisight": {
      "suggested_key": {
        "default": "Alt+L"
      },
      "description": "Toggle LiquiSight side panel on current page"
    }
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content/style.css"],
      "js": ["content/content.js"]
    }
  ]
}