# Chart Analyzer API Keys (set ONE of these)
# Priority: OpenRouter > Gemini > Demo Mode

# Option 1: OpenRouter (recommended - OpenAI-compatible)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Option 2: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# If no keys are set, demo mode is used automatically
